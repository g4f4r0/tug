[Unit]
Description=Tug runner slot %i
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
# No runner without the egress rules: loading them is idempotent, and a failure keeps the slot down.
ExecStartPre=/usr/sbin/nft -f /usr/local/lib/tug/egress.nft
ExecStart=/usr/local/lib/tug/pool.sh %i
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
