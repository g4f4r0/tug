[Unit]
Description=Tug key service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User=@USER@
SupplementaryGroups=docker
EnvironmentFile=-/etc/tug/tug.env
ExecStartPre=+/usr/sbin/nft -f /usr/local/lib/tug/egress.nft
# A container left over from a crash would block the name.
ExecStartPre=-/usr/bin/docker rm -f tug-keys
# Only the key service's own settings enter its container, so the GitHub App's key never does.
ExecStart=/usr/bin/docker run --rm --init --name tug-keys --network host --user node \
  -v /usr/local/lib/tug/app:/tug:ro \
  -e TUG_ACCOUNTS -e TUG_REVIEW_MODEL -e TUG_REVIEW_REASONING_EFFORT -e TUG_SECURITY_MODEL -e TUG_SECURITY_REASONING_EFFORT \
  -e TUG_OPENAI_API_KEY -e TUG_OPENAI_BASE_URL -e TUG_ANTHROPIC_API_KEY -e TUG_ANTHROPIC_BASE_URL \
  node:24 node /tug/src/bin.ts keys --listen 172.30.99.1:8787
ExecStop=/usr/bin/docker stop tug-keys
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
