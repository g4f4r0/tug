[Unit]
Description=Tug key service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User=@SECRETS_USER@
Environment=TUG_KEYS_OWNERS=@OWNERS@
Environment="TUG_KEYS_WORKFLOWS=hellogafaro/tug/.github/workflows/review.yml@refs/heads/main"
ExecStartPre=+/usr/sbin/nft -f /usr/local/lib/tug/egress.nft
ExecStart=/usr/bin/infisical run --projectId @PROJECT@ --env @ENV@ --silent -- /usr/local/lib/tug/node/bin/tug keys --listen 172.30.99.1:8787
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
