[Unit]
Description=Tug key service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User=@USER@
EnvironmentFile=-/etc/tug/tug.env
ExecStartPre=+/usr/sbin/nft -f /usr/local/lib/tug/egress.nft
ExecStart=@RUN@/usr/local/lib/tug/node/bin/tug keys --listen 172.30.99.1:8787
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
