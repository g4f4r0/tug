[Unit]
Description=Tug runners
Wants=network-online.target docker.service tug-keys.service
After=network-online.target docker.service tug-keys.service

[Service]
User=@USER@
SupplementaryGroups=docker
EnvironmentFile=-/etc/tug/tug.env
# No runner without the egress rules: loading them is idempotent, and a failure keeps the service down.
ExecStartPre=+/usr/sbin/nft -f /usr/local/lib/tug/egress.nft
ExecStart=@RUN@/usr/local/lib/tug/tug-runners
Restart=always
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
