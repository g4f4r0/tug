[Unit]
Description=Tug runners
Requires=tug-docker.service
Wants=tug-keys.service
After=tug-docker.service tug-keys.service
PartOf=tug-docker.service

[Service]
EnvironmentFile=-%h/.config/tug/tug.env
Environment=DOCKER_HOST=unix://%t/tug/docker.sock
# No runner without the egress rules: loading them is idempotent, and a failure keeps the service down.
ExecStartPre=%h/.local/share/tug/egress.sh
ExecStart=%h/.local/share/tug/tug-runners
Restart=always
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
