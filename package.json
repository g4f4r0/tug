{
  "name": "tug",
  "version": "0.0.1",
  "description": "PR review, security review and merge in CI, on your own runners, with any model.",
  "license": "MIT",
  "type": "module",
  "repository": "github:g4f4r0/tug",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tug": "dist/bin.js"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "tug": "node src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "node --experimental-strip-types scripts/schema.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.1"
  }
}
